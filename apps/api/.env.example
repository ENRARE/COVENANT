# Copy into a deployment secret manager; never commit a populated .env file.
COVENANT_MODE=deployment
COVENANT_API_HOST=127.0.0.1
COVENANT_API_PORT=8787
COVENANT_DATABASE_FILENAME=./var/covenant-platform.sqlite
COVENANT_WEBHOOK_MASTER_KEY=hex:<64-hex-characters>
COVENANT_AUTHORIZATION_RESOLVER_MODULE=./dist/authorization-resolver.js
COVENANT_EXECUTION_ADAPTER_MODULE=./dist/execution-adapter.js
COVENANT_ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional: comma-separated HTTPS origins; empty means deny-by-default.
COVENANT_CORS_ORIGINS=
