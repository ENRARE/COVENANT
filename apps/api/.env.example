# Copy into a deployment secret manager; never commit a populated .env file.
COVENANT_MODE=deployment
COVENANT_API_HOST=127.0.0.1
COVENANT_API_PORT=8787
# Explicitly choose sqlite for local/test deployments. For PostgreSQL set
# COVENANT_DATABASE_DRIVER=postgres, COVENANT_DATABASE_URL, and provide a
# deployment-owned COVENANT_DATABASE_MODULE.
COVENANT_DATABASE_DRIVER=sqlite
COVENANT_DATABASE_FILENAME=./var/covenant-platform.sqlite
# COVENANT_DATABASE_URL=postgresql://...
# COVENANT_DATABASE_MODULE=/run/secrets/covenant-runtime-store.js
COVENANT_WEBHOOK_MASTER_KEY=hex:<64-hex-characters>
COVENANT_AUTHORIZATION_RESOLVER_MODULE=./dist/deployment/authorization-resolver-entrypoint.js
COVENANT_AUTHORIZATION_SPEC_FILE=/run/secrets/covenant-authorization-spec.json
COVENANT_EXECUTION_ADAPTER_MODULE=./dist/deployment/execution-adapter-entrypoint.js
COVENANT_EXECUTOR_WORKER_URL=https://executor.internal.example
COVENANT_EXECUTOR_WORKER_AUTH_TOKEN=<internal-channel-secret-at-least-32-characters>
COVENANT_ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional: comma-separated HTTPS origins; empty means deny-by-default.
COVENANT_CORS_ORIGINS=
