# Worker deployment configuration is supplied by the host secret manager.
# The worker process must receive this channel credential and construct the
# existing ExecutorService with isolated provider dependencies.
COVENANT_EXECUTOR_WORKER_AUTH_TOKEN=<internal-channel-secret-at-least-32-characters>
COVENANT_EXECUTOR_SERVICE_MODULE=./dist/deployment-service.js
COVENANT_EXECUTOR_WORKER_HOST=0.0.0.0
COVENANT_EXECUTOR_WORKER_PORT=8788
# Durable operation journal directory (deployment-owned, mode 0700).
COVENANT_EXECUTOR_OPERATION_STORE_DIRECTORY=/var/lib/covenant-executor
COVENANT_EXECUTOR_COVENANT_SPEC_FILE=/run/secrets/covenant-executor-covenant-spec.json
# Provider-owned dependency inputs consumed by the existing constructors:
# ARC_RPC_URL
# COVENANT_VAULT_ADDRESS
# CIRCLE_API_KEY
# CIRCLE_ENTITY_SECRET
# CIRCLE_WALLET_ID
# EXECUTOR_SIGNER_SOURCE
