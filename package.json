{
  "name": "covenant",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint:root": "eslint eslint.config.mjs playwright.config.ts scripts packages/config tests/contract-evidence tests/e2e",
    "lint": "pnpm lint:root && turbo lint",
    "typecheck:root": "tsc -p tsconfig.root.json --noEmit && tsc -p tests/contract-evidence/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:root && turbo typecheck",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:security": "node --test scripts/check-private-artifacts.test.mjs scripts/scan-secrets.test.mjs",
    "check:private-artifacts": "node scripts/check-private-artifacts.mjs",
    "check:env-files": "node scripts/check-env-files.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "security:check": "pnpm check:private-artifacts && pnpm check:env-files && pnpm scan:secrets",
    "security:precommit": "pnpm security:check && git diff --cached --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "pnpm test:scripts && turbo test",
    "install:contracts:deps": "node scripts/install-contract-dependencies.mjs",
    "verify:contracts:deps": "node scripts/verify-contract-dependencies.mjs",
    "generate:contract-abi": "node scripts/generate-contract-abi.mjs",
    "verify:contract-abi": "node scripts/verify-contract-abi.mjs",
    "verify:cov002-files": "node scripts/verify-cov002-files.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "contracts:evidence:local": "node scripts/run-contract-evidence.mjs",
    "cov018:prepare": "node scripts/cov018/prepare-live-signed-flow.mjs",
    "arc:plan": "node scripts/arc/plan.mjs",
    "arc:preflight": "node scripts/arc/preflight.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:audit": "pnpm --filter @covenant/audit... build && pnpm --filter @covenant/audit test",
    "e2e:install-browser": "node scripts/install-playwright-chromium.mjs",
    "e2e:preflight": "node scripts/playwright-browser-preflight.mjs",
    "test:e2e": "node scripts/run-playwright-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:without-contracts": "pnpm verify:cov002-files && pnpm verify:cov010-evidence && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:openapi-sdk && pnpm test:sdk-release && pnpm test:e2e && pnpm test:integration && pnpm security:check",
    "verify": "pnpm verify:without-contracts && pnpm verify:contract-abi && pnpm test:contracts && pnpm contracts:evidence:local",
    "demo:reset": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js RESET",
    "demo:seed": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js SEED",
    "demo:health": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js GET_HEALTH",
    "demo:run": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js RUN_DEMO",
    "audit:project": "pnpm --silent --filter @covenant/audit... build && node packages/audit/dist/cli.js",
    "verify:cov010-evidence": "pnpm --filter @covenant/spec build && node scripts/verify-cov010-deployment-evidence.mjs",
    "verify:openapi-sdk": "pnpm --filter @covenant/sdk build && node scripts/verify-openapi-sdk.mjs",
    "test:sdk-release": "pnpm --filter @covenant/sdk build && node scripts/sdk-package-consumer.mjs"
  },
  "devDependencies": {
    "@covenant/agent": "workspace:*",
    "@covenant/authority": "workspace:*",
    "@covenant/config": "workspace:*",
    "@covenant/demo": "workspace:*",
    "@covenant/executor": "workspace:*",
    "@covenant/spec": "workspace:*",
    "@covenant/vendor": "workspace:*",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "pnpm": "11.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "viem": "^2.33.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  }
}
