{
  "name": "covenant",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint:root": "eslint eslint.config.mjs playwright.config.ts scripts packages/config tests/contract-evidence",
    "lint": "pnpm lint:root && turbo lint",
    "typecheck:root": "tsc -p tsconfig.root.json --noEmit && tsc -p tests/contract-evidence/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:root && turbo typecheck",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "pnpm test:scripts && turbo test",
    "install:contracts:deps": "node scripts/install-contract-dependencies.mjs",
    "verify:contracts:deps": "node scripts/verify-contract-dependencies.mjs",
    "generate:contract-abi": "node scripts/generate-contract-abi.mjs",
    "verify:contract-abi": "node scripts/verify-contract-abi.mjs",
    "verify:cov002-files": "node scripts/verify-cov002-files.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "contracts:evidence:local": "node scripts/run-contract-evidence.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "node scripts/not-implemented.mjs end-to-end-tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env-files": "node scripts/check-env-files.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify:without-contracts": "pnpm verify:cov002-files && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:integration && pnpm check:env-files && pnpm scan:secrets",
    "verify": "pnpm verify:without-contracts && pnpm verify:contract-abi && pnpm test:contracts && pnpm contracts:evidence:local",
    "demo:reset": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js RESET",
    "demo:seed": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js SEED",
    "demo:health": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js GET_HEALTH",
    "demo:run": "pnpm --silent --filter @covenant/demo... build && node apps/demo/dist/cli.js RUN_DEMO"
  },
  "devDependencies": {
    "@covenant/agent": "workspace:*",
    "@covenant/authority": "workspace:*",
    "@covenant/demo": "workspace:*",
    "@covenant/executor": "workspace:*",
    "@covenant/spec": "workspace:*",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "viem": "^2.33.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  }
}
