FROM node:24-bookworm-slim AS build

ENV COREPACK_HOME=/tmp/corepack
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN corepack enable \
  && corepack prepare pnpm@11.7.0 --activate

WORKDIR /workspace
COPY . .

# Build and deploy only the isolated executor dependency closure. The API,
# contract, web, and landing packages remain outside the deployed output.
RUN pnpm install --frozen-lockfile --ignore-scripts

RUN pnpm --filter @covenant/executor... build \
  && pnpm deploy --filter @covenant/executor --prod --legacy /out \
  && rm -rf /out/src /out/test /out/*.ts /out/vitest.config.ts \
    /out/.env.example /out/README.md /out/.turbo /out/tsconfig*.json \
  && find /out/node_modules/.pnpm -type d \
    -path '*/node_modules/@covenant/*/src' -prune -exec rm -rf '{}' + \
  && find /out/node_modules/.pnpm -type d \
    -path '*/node_modules/@covenant/*/test' -prune -exec rm -rf '{}' + \
  && find /out -type f -name '.env*' -delete

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV COVENANT_EXECUTOR_WORKER_HOST=0.0.0.0
ENV COVENANT_EXECUTOR_WORKER_PORT=8788

WORKDIR /app
COPY --from=build --chown=node:node /out/ ./

# Mount the durable operation journal here. Provider credentials and signer
# material are supplied by the deployment-owned service module, never baked
# into this image.
RUN mkdir -p /var/lib/covenant-executor \
  && chown node:node /var/lib/covenant-executor

USER node
EXPOSE 8788
STOPSIGNAL SIGTERM
CMD ["node", "dist/worker-main.js"]
