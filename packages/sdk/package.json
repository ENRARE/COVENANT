{
  "name": "@covenant/sdk",
  "version": "0.1.0",
  "description": "Server-side TypeScript client for the Covenant Platform v1 developer API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ENRARE/COVENANT.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ENRARE/COVENANT#readme",
  "keywords": [
    "covenant",
    "payments",
    "arc",
    "usdc",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
